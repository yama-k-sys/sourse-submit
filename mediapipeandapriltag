def setup_camera_properties(cap):
    """
    カメラ設定。
    """
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, FRAME_WIDTH)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, FRAME_HEIGHT)
    cap.set(cv2.CAP_PROP_FPS, TARGET_FPS)

    # 遅延を減らすための設定
    cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)

    cap.set(cv2.CAP_PROP_AUTOFOCUS, 0)


def open_gopro_camera():

    candidates = [
        ("GoPro name + CAP_DSHOW", f"video={GOPRO_CAMERA_NAME}", cv2.CAP_DSHOW),
        ("GoPro index + CAP_DSHOW", CAMERA_INDEX, cv2.CAP_DSHOW),
        ("GoPro index + DEFAULT", CAMERA_INDEX, None),
    ]

    for label, source, backend in candidates:
        print(f"カメラ接続テスト中: {label}")

        if backend is None:
            cap = cv2.VideoCapture(source)
        else:
            cap = cv2.VideoCapture(source, backend)

        if not cap.isOpened():
            print("  -> 開けませんでした")
            cap.release()
            continue

        setup_camera_properties(cap)

        # 数フレーム読んで確認
        ok = False
        test_frame = None

        for _ in range(20):
            ret, frame = cap.read()
            if ret and frame is not None and frame.size > 0:
                ok = True
                test_frame = frame
                break
            time.sleep(0.05)

        if ok:
            h, w = test_frame.shape[:2]
            print(f"  -> 使用可能: {label}, size={w}x{h}")
            return cap
        else:
            print("  -> 開けたが映像を取得できませんでした")
            cap.release()

    return None


