set_aruco_param(april_parameters, "adaptiveThreshWinSizeStep", 10)
set_aruco_param(april_parameters, "minMarkerPerimeterRate", 0.02)
set_aruco_param(april_parameters, "maxMarkerPerimeterRate", 4.0)

