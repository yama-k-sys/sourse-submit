print(f"腕特徴量CSV: {arm_feature_csv_path}")
print("終了するには q キーを押してください。")

try:
    while True:
        ret, frame = cap.read()

        if not ret:
            print("フレームを取得できませんでした。")
            break

        frame_count += 1
        elapsed_time = time.perf_counter() - start_time

        if USE_MIRROR_DISPLAY:
            frame = cv2.flip(frame, 1)

        h, w, _ = frame.shape
        if (w,h) != calibrated_size:
            raise RuntimeError("Camera resolution changed during recording.")

        should_save = (frame_count % SAVE_EVERY_N_FRAMES == 0)
        raw_image_name = ""
        if should_save and SAVE_RAW_FRAMES:
            raw_image_name = f"raw_frames/frame_{frame_count:06d}.jpg"
            if not cv2.imwrite(str(output_dir / raw_image_name), frame, [cv2.IMWRITE_JPEG_QUALITY, 95]):
                raise RuntimeError("Failed to save raw frame")

        # ==================================================
        # MediaPipeによる手・姿勢の検出
        # ==================================================
        rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)

        rgb_frame.flags.writeable = False
        hand_results = hands.process(rgb_frame)
        pose_results = pose.process(rgb_frame)
        rgb_frame.flags.writeable = True

        # ==================================================
        # AprilTagの検出
        # ==================================================
        gray_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

        tag_corners, tag_ids, rejected_candidates = detect_apriltags(
            gray_frame
        )

        # ==================================================
        # Poseの腕ランドマークを描画・CSV保存
        # ==================================================
        if pose_results.pose_landmarks:
            pose_lms = pose_results.pose_landmarks
            pose_world_lms = pose_results.pose_world_landmarks

            # 肩・肘・手首のみ描画
            for a, b in ARM_CONNECTIONS:
                lm_a = pose_lms.landmark[a]
                lm_b = pose_lms.landmark[b]

                ax = int(lm_a.x * w)
                ay = int(lm_a.y * h)
                bx = int(lm_b.x * w)
                by = int(lm_b.y * h)

                cv2.line(
                    frame,
                    (ax, ay),
                    (bx, by),
                    (255, 128, 0),
                    3
                )

            for lm_id, lm_name in POSE_ARM_POINTS.items():
                lm = pose_lms.landmark[lm_id]

                x_px = int(lm.x * w)
                y_px = int(lm.y * h)

                cv2.circle(frame, (x_px, y_px), 7, (255, 128, 0), -1)
                cv2.putText(
                    frame,
                    lm_name,
                    (x_px + 8, y_px - 8),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.5,
                    (255, 128, 0),
                    2
                )

                if should_save:
                    world_x = ""
                    world_y = ""
                    world_z = ""

                    if pose_world_lms:
                        wlm = pose_world_lms.landmark[lm_id]
                        world_x = wlm.x
                        world_y = wlm.y
                        world_z = wlm.z

                    pose_writer.writerow([
                        frame_count,
                        elapsed_time,
                        lm_id,
                        lm_name,
                        lm.x,
                        lm.y,
                        lm.z,
                        lm.visibility,
                        x_px,
                        y_px,
                        world_x,
                        world_y,
                        world_z
                    ])

            # 腕の傾き・肘角度を保存
            if should_save:
                l_shoulder = get_landmark(pose_lms, 11)
                r_shoulder = get_landmark(pose_lms, 12)
                l_elbow = get_landmark(pose_lms, 13)
                r_elbow = get_landmark(pose_lms, 14)
                l_wrist = get_landmark(pose_lms, 15)
                r_wrist = get_landmark(pose_lms, 16)

                left_upper_arm_angle_xy = calc_vector_angle_xy_deg(l_shoulder, l_elbow, w, h)
                left_forearm_angle_xy = calc_vector_angle_xy_deg(l_elbow, l_wrist, w, h)
                right_upper_arm_angle_xy = calc_vector_angle_xy_deg(r_shoulder, r_elbow, w, h)
                right_forearm_angle_xy = calc_vector_angle_xy_deg(r_elbow, r_wrist, w, h)

                left_elbow_angle_world = ""
                right_elbow_angle_world = ""

                if pose_world_lms:
                    wl_shoulder = to_np3(pose_world_lms.landmark[11])
                    wr_shoulder = to_np3(pose_world_lms.landmark[12])
                    wl_elbow = to_np3(pose_world_lms.landmark[13])
                    wr_elbow = to_np3(pose_world_lms.landmark[14])
                    wl_wrist = to_np3(pose_world_lms.landmark[15])
                    wr_wrist = to_np3(pose_world_lms.landmark[16])

                    left_elbow_angle_world = calc_angle_deg(wl_shoulder, wl_elbow, wl_wrist)
                    right_elbow_angle_world = calc_angle_deg(wr_shoulder, wr_elbow, wr_wrist)

                arm_feature_writer.writerow([
                    frame_count,
                    elapsed_time,
                    left_upper_arm_angle_xy,
                    left_forearm_angle_xy,
                    right_upper_arm_angle_xy,
                    right_forearm_angle_xy,
                    left_elbow_angle_world,
                    right_elbow_angle_world,
                    l_shoulder.visibility,
                    l_elbow.visibility,
                    l_wrist.visibility,
                    r_shoulder.visibility,
                    r_elbow.visibility,
                    r_wrist.visibility
                ])

        # ==================================================
        # 手の検出結果を描画・CSV保存
        # ==================================================
        if hand_results.multi_hand_landmarks:
            for hand_id, hand_landmarks in enumerate(
                hand_results.multi_hand_landmarks
            ):

                handedness = "Unknown"
                hand_score = ""

                if hand_results.multi_handedness:
                    handedness_result = hand_results.multi_handedness[hand_id]
                    handedness = handedness_result.classification[0].label
                    hand_score = handedness_result.classification[0].score

                handedness_candidate = handedness
                if SWAP_HAND_LABELS_FOR_DISPLAY:
                    handedness_candidate = {"Left":"Right", "Right":"Left"}.get(handedness, handedness)

                world_landmarks = None
                if hand_results.multi_hand_world_landmarks:
                    world_landmarks = hand_results.multi_hand_world_landmarks[hand_id]

                mp_drawing.draw_landmarks(
                    frame,
                    hand_landmarks,
                    mp_hands.HAND_CONNECTIONS,
                    mp_styles.get_default_hand_landmarks_style(),
                    mp_styles.get_default_hand_connections_style()
                )

                if should_save:
                    for lm_id, lm in enumerate(hand_landmarks.landmark):
                        x_px = int(lm.x * w)
                        y_px = int(lm.y * h)

                        world_x = ""
                        world_y = ""
                        world_z = ""

                        if world_landmarks is not None:
                            wlm = world_landmarks.landmark[lm_id]
                            world_x = wlm.x
                            world_y = wlm.y
                            world_z = wlm.z

                        hand_writer.writerow([
                            frame_count,
                            elapsed_time,
                            hand_id,
                            handedness,
                            hand_score,
                            lm_id,
                            lm.x,
                            lm.y,
                            lm.z,
                            x_px,
                            y_px,
                            world_x,
                            world_y,
                            world_z,
                            handedness_candidate
                        ])

                for lm_id, finger_name in FINGER_TIPS.items():
                    lm = hand_landmarks.landmark[lm_id]

                    cx = int(lm.x * w)
                    cy = int(lm.y * h)

                    cv2.circle(
                        frame,
                        (cx, cy),
                        8,
                        (0, 255, 255),
                        -1
                    )

                    cv2.putText(
                        frame,
                        finger_name,
                        (cx + 10, cy - 10),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.6,
                        (0, 255, 255),
                        2
                    )

                wrist = hand_landmarks.landmark[0]

                wx = int(wrist.x * w)
                wy = int(wrist.y * h)

                cv2.circle(
                    frame,
                    (wx, wy),
                    8,
                    (255, 0, 255),
                    -1
                )

                cv2.putText(
                    frame,
                    f"Hand {hand_id + 1} {handedness_candidate} (raw {handedness})",
                    (wx + 10, wy + 10),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.7,
                    (255, 0, 255),
                    2
                )

        # ==================================================
        # AprilTagの検出結果を描画・CSV保存
        # ==================================================
        tag_count = 0

        if tag_ids is not None and len(tag_ids) > 0:
            tag_count = len(tag_ids)

            cv2.aruco.drawDetectedMarkers(
                frame,
                tag_corners,
                tag_ids
            )

            rvecs, tvecs, _ = cv2.aruco.estimatePoseSingleMarkers(
                tag_corners,
                TAG_SIZE_M,
                camera_matrix,
                dist_coeffs
            )

            for i, tag_id in enumerate(tag_ids.flatten()):
                corners = tag_corners[i]
                points_float = corners.reshape(4, 2)
                points = points_float.astype(int)

                top_left = points[0]
                center_x = float(np.mean(points_float[:, 0]))
                center_y = float(np.mean(points_float[:, 1]))

                rvec = rvecs[i][0]
                tvec = tvecs[i][0]

                cv2.drawFrameAxes(
                    frame,
                    camera_matrix,
                    dist_coeffs,
                    rvec,
                    tvec,
                    TAG_SIZE_M * 0.5
                )

                if should_save:
                    tag_writer.writerow([
                        frame_count,
                        elapsed_time,
                        int(tag_id),
                        center_x,
                        center_y,
                        float(points_float[0][0]),
                        float(points_float[0][1]),
                        float(points_float[1][0]),
                        float(points_float[1][1]),
                        float(points_float[2][0]),
                        float(points_float[2][1]),
                        float(points_float[3][0]),
                        float(points_float[3][1]),
                        float(rvec[0]),
                        float(rvec[1]),
                        float(rvec[2]),
                        float(tvec[0]),
                        float(tvec[1]),
                        float(tvec[2])
                    ])

                cv2.circle(
                    frame,
                    (int(center_x), int(center_y)),
                    7,
                    (0, 0, 255),
                    -1
                )

                cv2.putText(
                    frame,
                    f"AprilTag ID: {tag_id}",
                    (top_left[0], top_left[1] - 15),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.7,
                    (0, 0, 255),
                    2
                )

                cv2.putText(
                    frame,
                    f"Center: ({int(center_x)}, {int(center_y)})",
                    (int(center_x) + 10, int(center_y) + 25),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.55,
                    (0, 0, 255),
                    2
                )

                cv2.putText(
                    frame,
                    f"Z: {tvec[2]:.2f} m",
                    (int(center_x) + 10, int(center_y) + 50),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.55,
                    (0, 0, 255),
                    2
                )

        # ==================================================
        # FPS計算
        # ==================================================
        if should_save:
            frame_log_writer.writerow([frame_count, elapsed_time,
                len(hand_results.multi_hand_landmarks or []),
                int(pose_results.pose_landmarks is not None), tag_count, raw_image_name])
        current_time = time.perf_counter()

        if prev_time != 0:
            fps = 1 / (current_time - prev_time)
        else:
            fps = 0

        prev_time = current_time

        # ==================================================
        # 画面表示
        # ==================================================
        cv2.putText(
            frame,
            f"FPS: {fps:.1f}",
            (20, 40),
            cv2.FONT_HERSHEY_SIMPLEX,
            1.0,
            (0, 255, 0),
            2
        )

        cv2.putText(
            frame,
            f"AprilTags: {tag_count}",
            (20, 80),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (0, 255, 0),
            2
        )

        cv2.putText(
            frame,
            f"Frame: {frame_count}",
            (20, 120),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (0, 255, 0),
            2
        )

        cv2.putText(
            frame,
            "Press q to quit",
            (20, 160),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (0, 255, 0),
            2
        )

        cv2.imshow(
            "GoPro Hand + Pose Arm + AprilTag Detection",
            frame
        )

        if frame_count % 30 == 0:
            frame_log_file.flush()
            hand_file.flush()
            tag_file.flush()
            pose_file.flush()
            arm_feature_file.flush()

        if cv2.waitKey(1) & 0xFF == ord("q"):
            break

finally:
    frame_log_file.flush()
    frame_log_file.close()
    hand_file.flush()
    tag_file.flush()
    pose_file.flush()
    arm_feature_file.flush()

    hand_file.close()
    tag_file.close()
    pose_file.close()
    arm_feature_file.close()

    cap.release()
    hands.close()
    pose.close()
    cv2.destroyAllWindows()

    print("終了しました。")
    print(f"手座標CSV: {hand_csv_path}")
    print(f"AprilTag CSV: {tag_csv_path}")
    print(f"腕ランドマークCSV: {pose_csv_path}")
    print(f"腕特徴量CSV: {arm_feature_csv_path}")
