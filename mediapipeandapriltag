# 角度計算用関数
# ==================================================
def to_np3(point):
    return np.array([point.x, point.y, point.z], dtype=np.float32)


def calc_angle_deg(a, b, c):
    """
    3点 a-b-c の角度を計算する。
    bを中心とした角度。
    """
    ba = a - b
    bc = c - b

    norm_ba = np.linalg.norm(ba)
    norm_bc = np.linalg.norm(bc)

    if norm_ba < 1e-8 or norm_bc < 1e-8:
        return ""

    cos_angle = np.dot(ba, bc) / (norm_ba * norm_bc)
    cos_angle = np.clip(cos_angle, -1.0, 1.0)
    return float(np.degrees(np.arccos(cos_angle)))


def calc_vector_angle_xy_deg(p1, p2, image_width, image_height):
    """
    画像平面上で、p1 -> p2 のベクトルが水平方向に対して何度傾いているか。
    右方向が0度、下方向が正になる。
    """
    dx = (p2.x - p1.x) * image_width
    dy = (p2.y - p1.y) * image_height

    if abs(dx) < 1e-8 and abs(dy) < 1e-8:
        return ""

    return float(np.degrees(np.arctan2(dy, dx)))


def get_landmark(landmarks, idx):
    if landmarks is None:
        return None
    return landmarks.landmark[idx]


